<odoo>
    <record id="product_template_form_view_inherit_min_quantity" model="ir.ui.view">
        <field name="name">product.template.form.inherit.minimum.quantity</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Add Minimum Quantity field after Category in General Information page -->
            <xpath expr="//page[@name='general_information']//field[@name='categ_id']" position="after">
                <field name="minimum_quantity" 
                       string="Minimum Quantity"/>
                     
            </xpath>
        </field>
    </record>

    <!-- For Product Variant form view -->
    <record id="product_variant_form_view_inherit_min_quantity" model="ir.ui.view">
        <field name="name">product.product.form.inherit.minimum.quantity</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <!-- Add Minimum Quantity field after Category in Product Variant form -->
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="minimum_quantity" 
                       string="Minimum Quantity"/>
            </xpath>
        </field>
    </record>
</odoo>