<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_users_form_inherit_notify_user" model="ir.ui.view">
    <field name="name">res.users.form.inherit.notify.user</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_form"/>
    <field name="arch" type="xml">
      <!-- Add Notify User checkbox inside the preferences group -->
      <xpath expr="//page[@name='preferences']/group" position="before">
        <group>
          <field name="notify_user" string="Notify User"
                 help="Enable this option to receive low stock or system notifications."/>
        </group>
      </xpath>
    </field>
  </record>

</odoo>
